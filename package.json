		],
		"nodes": [
			"dist/nodes/Fibery/Fibery.node.js",
			"dist/nodes/Fibery/FiberyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.44.5",
		"@types/node": "24.10.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
