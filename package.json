{
	"name": "@fibery/n8n-nodes-fibery",
	"version": "0.1.24",
	"description": "n8n node for Fibery",
	"license": "MIT",
	"homepage": "https://github.com/Fibery-inc/n8n-nodes-fibery",
	"keywords": [
		"n8n-community-node-package",
		"fibery"
	],
	"engines": {
		"node": "24.18.0"
	},
	"packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
	"author": {
		"name": "Misha Yermolayev",
		"email": "misha@fibery.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Fibery-inc/n8n-nodes-fibery"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
